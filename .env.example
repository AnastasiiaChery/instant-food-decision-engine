# ── LLM provider ──────────────────────────────────────────────────────────────
# AI_PROVIDER selects the backend: "groq" (default) | "openai" (any OpenAI-compatible
# endpoint) | "gemini". Switching providers is a config change only — no redeploy of code.
AI_PROVIDER=groq
#
# Models are split into two tiers to save cost: the "fast" tier handles light steps
# (intent parsing, UI translation) and the "heavy" tier handles reasoning-heavy steps
# (ranking, planning). Set both to the same model to disable tiering.
AI_MODEL=llama-3.3-70b-versatile          # heavy tier
AI_MODEL_FAST=llama-3.1-8b-instant        # fast/cheap tier
#
# API key for the selected provider. AI_API_KEY is preferred; if empty it falls back
# to GROQ_API_KEY (kept for backward compatibility with Groq-only deployments).
# Groq keys: console.groq.com · Gemini keys: aistudio.google.com/apikey
AI_API_KEY=
GROQ_API_KEY=
# Base URL — only used by AI_PROVIDER=openai (e.g. https://api.openai.com/v1 or another
# OpenAI-compatible host). Ignored for groq/gemini.
AI_BASE_URL=https://api.groq.com/openai/v1
#
# Example — Gemini free tier (huge TPM headroom, but free-tier requests are used for
# training; see docs/llm-provider-routing-plan.md):
#   AI_PROVIDER=gemini
#   AI_MODEL=gemini-2.5-flash
#   AI_MODEL_FAST=gemini-2.5-flash
#   AI_API_KEY=<your-gemini-key>

# ── LangSmith (optional, LLM observability) ──────────────────────────────────
# LangSmith is a tracing/debugging platform for LLM applications (smith.langchain.com).
# It is made by the same company as the LangChain library but is a separate product.
# When set, every LLM call (intent parsing, ranking, plan agent) is traced automatically.
# Leave blank to disable — the app works fine without it.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=instant-food-decision-engine

# ── First-party analytics (stored in our own Postgres, no third-party tracker) ──
# Product behaviour (page views, searches, navigate/favorite) and per-request ops
# metrics (latency, errors) are written to the events / request_log tables.
# Set ANALYTICS_ENABLED=false to turn off ingest + the request_log middleware.
ANALYTICS_ENABLED=true
# Comma-separated emails allowed to read the dashboard at GET /api/v1/admin/stats.
# Empty = the dashboard is locked (returns 404). Set this to your own login email.
ANALYTICS_ADMIN_EMAILS=
# Retention windows for the background prune job (runs daily inside the app).
ANALYTICS_EVENTS_RETENTION_DAYS=90
ANALYTICS_REQUESTS_RETENTION_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
# ENVIRONMENT=production makes the app refuse to start with insecure defaults
# (an unset/default JWT_SECRET or a missing LLM API key). Use "development" locally.
ENVIRONMENT=development
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379
PORT=8000
# Comma-separated Host header allowlist (TrustedHostMiddleware). "*" disables the
# check (dev). REQUIRED in production — set to your domain(s), e.g.:
#   ALLOWED_HOSTS=nompilot.app,www.nompilot.app
ALLOWED_HOSTS=*
# Trusted upstream proxy IPs for uvicorn --forwarded-allow-ips. "*" trusts the
# platform load balancer's X-Forwarded-For so per-IP rate limiting sees the real
# client IP. Narrow this if the container is reachable without going through the LB.
FORWARDED_ALLOW_IPS=*
DISTANCE_WEIGHT=0.75
RELIABILITY_WEIGHT=0.25
SEARCH_RADIUS_M=1500
MAX_RADIUS_M=3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/instantfood
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_S=1800

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`).
# The app refuses to start in production while this is unset or left at the default.
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_MINUTES=10080
# Google OAuth (optional — leave blank to disable "Continue with Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Telegram (beta feedback notifications) ────────────────────────────────────
# Create a bot via @BotFather, then get your chat_id via @userinfobot.
# Leave blank to disable feedback notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

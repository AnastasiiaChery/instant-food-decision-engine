# ── Groq (LLM provider) ──────────────────────────────────────────────────────
# Groq runs open-source models (Llama etc.) via an OpenAI-compatible API.
# Get your key at console.groq.com
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ── LangSmith (optional, LLM observability) ──────────────────────────────────
# LangSmith is a tracing/debugging platform for LLM applications (smith.langchain.com).
# It is made by the same company as the LangChain library but is a separate product.
# When set, every LLM call (intent parsing, ranking, plan agent) is traced automatically.
# Leave blank to disable — the app works fine without it.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=instant-food-decision-engine

# ── App ───────────────────────────────────────────────────────────────────────
# ENVIRONMENT=production makes the app refuse to start with insecure defaults
# (an unset/default JWT_SECRET or an empty GROQ_API_KEY). Use "development" locally.
ENVIRONMENT=development
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379
PORT=8000
DISTANCE_WEIGHT=0.75
RELIABILITY_WEIGHT=0.25
SEARCH_RADIUS_M=1500
MAX_RADIUS_M=3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/instantfood
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_S=1800

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`).
# The app refuses to start in production while this is unset or left at the default.
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_MINUTES=10080
# Google OAuth (optional — leave blank to disable "Continue with Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Telegram (beta feedback notifications) ────────────────────────────────────
# Create a bot via @BotFather, then get your chat_id via @userinfobot.
# Leave blank to disable feedback notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
